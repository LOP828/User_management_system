DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=replace-me
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Shanghai

# Django dev 默认依赖 PostgreSQL。
# 需先准备可连接的数据库实例，并创建下列库/账号。
DATABASE_NAME=matchmaker
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# Redis 仅用于 Celery/提醒任务；基础 HTTP API 联调阶段可暂不启动。
REDIS_URL=redis://127.0.0.1:6379/0

JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=7

# 企业微信通知（phase 1 第一批链路）
WECOM_NOTIFY_ENABLED=false
WECOM_NOTIFY_REMINDER_DUE_ENABLED=false
WECOM_WEBHOOK_URL=
WECOM_NOTIFY_TIMEOUT_SECONDS=5

# 可选：用于初始化默认管理员
INIT_ADMIN_PHONE=13800000000
INIT_ADMIN_NAME=默认管理员
INIT_ADMIN_PASSWORD=Passw0rd123!
INIT_ADMIN_WECHAT_ID=
